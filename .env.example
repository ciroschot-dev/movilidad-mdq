# Google Maps backend (Distance Matrix)
GOOGLE_MAPS_KEY=

# OpenWeather
WEATHER_API_KEY=

# Base de datos PostgreSQL (Neon o local)
SPRING_DATASOURCE_URL=jdbc:postgresql://tu-host.neon.tech:5432/movilidadmdq?sslmode=require
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=86400000

# Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# CORS frontend permitido
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redirect URI tras login con Google (en prod usar tu URL de Vercel)
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# Credenciales del admin inicial. Solo se usan la PRIMERA vez que se arranca
# contra una DB sin admin. Si ya existe el admin en la DB, estas variables
# no tienen efecto: la password real vive hasheada en la tabla "usuarios"
# y se cambia desde PUT /usuarios/{id}.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
